# PostgreSQL : valeurs de démonstration locales uniquement
POSTGRES_DB=akademia
POSTGRES_USER=akademia
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_POSTGRES_PASSWORD

# Sécurité de l'application : remplacer par une valeur aléatoire
JWT_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# MinIO : stockage local des documents
MINIO_ROOT_USER=akademiaadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_MINIO_PASSWORD

# Modèles IA
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# n8n : configuration d'authentification
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_KEY
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_LOCAL_N8N_PASSWORD
